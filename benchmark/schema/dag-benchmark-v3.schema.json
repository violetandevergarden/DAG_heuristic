{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.example/schema/dag-benchmark-v3.schema.json",
  "title": "Non-preemptive fixed-resource DAG scheduling benchmark v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "scenario", "family", "category",
    "objective", "time_unit", "semantics", "resources", "tasks"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "id": {"type": "string", "minLength": 1},
    "scenario": {"enum": ["single_channel", "muti_channel"]},
    "family": {"enum": ["parallel_chain", "complex_chain"]},
    "category": {"enum": ["random", "adversarial", "real"]},
    "objective": {"const": "makespan"},
    "time_unit": {"type": "string", "minLength": 1},
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preemption", "decision_epoch", "optional_idle", "compute_model",
        "resource_model", "preemption_cost", "minimum_quantum"
      ],
      "properties": {
        "preemption": {"const": "none"},
        "decision_epoch": {"const": "task_completion"},
        "optional_idle": {"const": true},
        "compute_model": {"const": "unbounded_parallel"},
        "resource_model": {"enum": ["exclusive", "exclusive_fixed_set"]},
        "preemption_cost": {"const": 0},
        "minimum_quantum": {"const": 0}
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "metadata": {"type": "object"}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "duration", "dependencies", "resources"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["compute", "communication"]},
          "duration": {"type": "integer", "minimum": 0},
          "dependencies": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "resources": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "metadata": {"type": "object"}
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"scenario": {"const": "single_channel"}}},
      "then": {
        "properties": {
          "semantics": {"properties": {"resource_model": {"const": "exclusive"}}}
        }
      }
    },
    {
      "if": {"properties": {"scenario": {"const": "muti_channel"}}},
      "then": {
        "properties": {
          "semantics": {"properties": {"resource_model": {"const": "exclusive_fixed_set"}}}
        }
      }
    }
  ]
}
